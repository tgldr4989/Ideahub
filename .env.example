# Copy this file to .env and fill in your values. .env is not committed to git.

# PostgreSQL connection (no password here). The database is created on first start if missing.
DATABASE_URL=postgresql://postgres@localhost:5432/ideahub
# Password on its own line, so characters like @ : / # need no encoding
PGPASSWORD=YOUR_PASSWORD

# Folder where uploaded images are saved
IDEAHUB_UPLOADS=./uploads

# 127.0.0.1 = this computer only; 0.0.0.0 = others on the network can connect
HOST=127.0.0.1
PORT=8000

# Only allow sign-in with emails on this domain (leave empty to allow any email)
IDEAHUB_EMAIL_DOMAIN=
