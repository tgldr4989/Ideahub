# Copy this file to .env and fill in your values. .env is not committed to git.

# PostgreSQL connection (no password here). The database is created on first start if missing.
DATABASE_URL=postgresql://postgres@localhost:5432/ideahub
# Password on its own line, so characters like @ : / # need no encoding
PGPASSWORD=YOUR_PASSWORD

# Folder where uploaded images are saved
IDEAHUB_UPLOADS=./uploads

# 127.0.0.1 = this computer only; 0.0.0.0 = others on the network can connect
HOST=127.0.0.1
PORT=8000

# Sign-in with Coremind Active Directory accounts. Each person binds as themselves
# (bat@coremind.mn + Windows password), so no service account is needed. Only accounts
# under LDAP_USER_BASE_DN (the Coremind OU) are let in.
LDAP_SERVER=dc.example.local
LDAP_USE_SSL=true
LDAP_PORT=636
LDAP_UPN_DOMAIN=example.com
LDAP_USER_BASE_DN=OU=Staff,DC=example,DC=local

# Set to 1 when the site is served over HTTPS
IDEAHUB_SECURE_COOKIE=

# ldap (default) or dev. dev = no password check, for local testing; only works with HOST=127.0.0.1
IDEAHUB_AUTH=ldap
